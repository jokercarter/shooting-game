FROM node:22-bookworm-slim AS web-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY build.mjs site.config.mjs learning-content.mjs learning-code.mjs ./
COPY public ./public
RUN node build.mjs

FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.12 "uvicorn[standard]==0.34.2"
COPY backend ./backend
COPY --from=web-build /app/dist ./dist
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8080')+'/health',timeout=3)"
CMD ["sh", "-c", "exec uvicorn backend.arena_public:app --host 0.0.0.0 --port ${PORT:-8080}"]
